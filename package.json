{
  "name": "assert-guard",
  "version": "1.0.0",
  "description": "A smart test quality gate CLI that lints your test suite for anti-patterns, architectural violations, and bad practices.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "assert-guard": "./bin/assert-guard.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "test-quality",
    "qa",
    "automation",
    "linter",
    "testing",
    "cypress",
    "playwright",
    "jest",
    "cli",
    "quality-gate"
  ],
  "author": "Ashutosh Parihar <qa.ashutosh3@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qa-ashutosh/assert-guard.git"
  },
  "bugs": {
    "url": "https://github.com/qa-ashutosh/assert-guard/issues"
  },
  "homepage": "https://github.com/qa-ashutosh/assert-guard#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.4",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  }
}
